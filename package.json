  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/lan-url.mjs && concurrently -n vite,api -c cyan,magenta \"vite\" \"node server.js\"",
    "lan": "node scripts/lan-url.mjs",
    "build": "tsc -b && vite build",
