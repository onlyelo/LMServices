    "express-rate-limit": "^8.6.2",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
