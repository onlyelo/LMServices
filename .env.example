# ---------------------------------------------------------------------------
# Telegram — lu uniquement côté serveur
# ---------------------------------------------------------------------------
# Pas de préfixe VITE_ : ces valeurs ne doivent jamais atteindre le navigateur.
# Le chat_id se récupère avec `npm run telegram:chat-id`, après avoir envoyé
# un premier message au bot depuis Telegram.
#
# En production, les renseigner dans Vercel : Settings > Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Port du serveur Express local (développement uniquement).
API_PORT=3001

# ---------------------------------------------------------------------------
# Front (facultatif)
# ---------------------------------------------------------------------------
# Laisser vide : le front appelle /api/devis en relatif, ce qui fonctionne
# aussi bien derrière le proxy Vite qu'en production sur Vercel. À renseigner
# seulement si l'API est servie sur un autre domaine.
VITE_API_BASE_URL=
